    "# ═══ MINE GANTT CHART ════════════════════════════════════════════════════════\n",
    "import plotly.figure_factory as ff\n",
    "\n",
    "gantt_data = []\n",
    "type_colors = {\n",
    "    'porphyry': 'rgb(21, 101, 192)',\n",
    "    'sx_ew':    'rgb(76, 175, 80)',\n",
    "    'underground': 'rgb(121, 85, 72)',\n",
    "}\n",
    "\n",
    "for mine_name, m in all_mines.items():\n",
    "    if m['nameplate_capacity_ktpa_cu'] > 0:\n",
    "        start = f\"{m['first_production_year']}-01-01\"\n",
    "        end_yr = m['first_production_year'] + m['mine_life_years']\n",
    "        end = f\"{end_yr}-01-01\"\n",
    "        gantt_data.append(dict(\n",
    "            Task=mine_name[:40],\n",
    "            Start=start,\n",
    "            Finish=end,\n",
    "            Resource=m['type']\n",
    "        ))\n",
    "\n",
    "try:\n",
    "    fig_gantt = ff.create_gantt(\n",
    "        gantt_data, colors=type_colors, index_col='Resource',\n",
    "        show_colorbar=True, group_tasks=True,\n",
    "        title=f\"{COMPANY_NAME} — Mine Production Timeline (Historical + Forecast)\"\n",
    "    )\n",
    "    fig_gantt.update_layout(height=550)\n",
    "    fig_gantt.show()\n",
    "except Exception as e:\n",
    "    print(f\"Gantt chart: {e}\")\n",
    "    # Fallback bar chart\n",
    "    mine_df = pd.DataFrame([{\n",
    "        'Mine': k[:35], 'Start': v['first_production_year'],\n",
    "        'Duration': v['mine_life_years'], 'Type': v['type'],\n",
    "        'Capacity': v['nameplate_capacity_ktpa_cu']\n",
    "    } for k, v in all_mines.items()])\n",
    "    fig_bar = px.bar(mine_df, x='Duration', y='Mine', color='Type', \n",
    "                     base='Start', orientation='h',\n",
    "                     title='Mine Lifetime Overview',\n",
    "                     color_discrete_map=type_colors)\n",
    "    fig_bar.update_layout(template='plotly_white', height=480)\n",
    "    fig_bar.show()\n"
   ]
