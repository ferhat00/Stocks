    "# ═══ BY-PRODUCT REVENUE CHART ════════════════════════════════════════════════\n",
    "bp_data = []\n",
    "for mine_name, m in mines.items():\n",
    "    cu_rev = m['nameplate_capacity_ktpa_cu'] * 1000 * LBS_PER_TONNE * COPPER_PRICE_BASE_LB / 1e6\n",
    "    au_rev = m.get('gold_koz_yr', 0) * GOLD_PRICE_OZ / 1e3\n",
    "    ag_rev = m.get('silver_koz_yr', 0) * SILVER_PRICE_OZ / 1e3\n",
    "    mo_rev = m.get('moly_mlbs_yr', 0) * MOLY_PRICE_LB\n",
    "    bp_data.append({\n",
    "        'Mine': mine_name[:35],\n",
    "        'Copper ($M)': round(cu_rev, 0),\n",
    "        'Gold ($M)': round(au_rev, 0),\n",
    "        'Silver ($M)': round(ag_rev, 0),\n",
    "        'Molybdenum ($M)': round(mo_rev, 0),\n",
    "    })\n",
    "\n",
    "df_bp = pd.DataFrame(bp_data)\n",
    "fig_bp = go.Figure()\n",
    "for col, color in zip(['Copper ($M)', 'Gold ($M)', 'Silver ($M)', 'Molybdenum ($M)'],\n",
    "                       ['#B87333', '#FFD700', '#C0C0C0', '#4A4A4A']):\n",
    "    fig_bp.add_trace(go.Bar(name=col.split(' ')[0], x=df_bp['Mine'], y=df_bp[col],\n",
    "                             marker_color=color))\n",
    "fig_bp.update_layout(\n",
    "    barmode='stack', title='Revenue Mix by Metal at Nameplate Capacity (Base Case, $M/yr)',\n",
    "    xaxis_tickangle=-30, template='plotly_white', height=480,\n",
    "    legend=dict(orientation=\"h\", y=1.05)\n",
    ")\n",
    "fig_bp.show()\n",
    "\n",
    "# Summary\n",
    "total_cu = df_bp['Copper ($M)'].sum()\n",
    "total_au = df_bp['Gold ($M)'].sum()\n",
    "total_ag = df_bp['Silver ($M)'].sum()\n",
    "total_mo = df_bp['Molybdenum ($M)'].sum()\n",
    "grand_total = total_cu + total_au + total_ag + total_mo\n",
    "print(f\"\\n💰 Revenue mix at nameplate (Base Case — ex-Kucing Liar):\")\n",
    "print(f\"   Copper:     ${total_cu:>7,.0f}M ({total_cu/grand_total*100:.0f}%)\")\n",
    "print(f\"   Gold:       ${total_au:>7,.0f}M ({total_au/grand_total*100:.0f}%)\")\n",
    "print(f\"   Silver:     ${total_ag:>7,.0f}M ({total_ag/grand_total*100:.0f}%)\")\n",
    "print(f\"   Molybdenum: ${total_mo:>7,.0f}M ({total_mo/grand_total*100:.0f}%)\")\n",
    "print(f\"   TOTAL:      ${grand_total:>7,.0f}M/yr\")\n",
    "print(f\"\\n   Gold represents {total_au/grand_total*100:.0f}% of revenue — CRITICAL for cost curve positioning\")\n"
