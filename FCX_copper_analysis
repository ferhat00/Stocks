    "# ═══ SENSITIVITY TABLE: EV vs WACC × COPPER PRICE ══════════════════════════\n",
    "wacc_range  = [0.07, 0.08, 0.09, 0.10, 0.11, 0.12, 0.13]\n",
    "price_range = [3.50, 4.00, 4.50, 5.00, 5.50, 6.00, 6.50]\n",
    "\n",
    "matrix_ev = []\n",
    "matrix_nav = []\n",
    "for w in wacc_range:\n",
    "    row_ev, row_nav = [], []\n",
    "    for p in price_range:\n",
    "        res = dcf_valuation(p, wacc_override=w, label=\"sens\")\n",
    "        row_ev.append(round(res['enterprise_value_usdm'] / 1000, 1))  # $B\n",
    "        row_nav.append(round(res['nav_per_share'], 1))\n",
    "    matrix_ev.append(row_ev)\n",
    "    matrix_nav.append(row_nav)\n",
    "\n",
    "df_sens_ev = pd.DataFrame(matrix_ev,\n",
    "    index=[f\"{int(w*100)}%\" for w in wacc_range],\n",
    "    columns=[f\"${p:.2f}\" for p in price_range])\n",
    "\n",
    "df_sens_nav = pd.DataFrame(matrix_nav,\n",
    "    index=[f\"{int(w*100)}%\" for w in wacc_range],\n",
    "    columns=[f\"${p:.2f}\" for p in price_range])\n",
    "\n",
    "fig_sens = make_subplots(rows=1, cols=2,\n",
    "    subplot_titles=[\"Enterprise Value ($ Billions)\", \"NAV per Share ($)\"])\n",
    "\n",
    "fig_sens.add_trace(go.Heatmap(\n",
    "    z=df_sens_ev.values, x=df_sens_ev.columns, y=df_sens_ev.index,\n",
    "    colorscale='RdYlGn', text=df_sens_ev.values,\n",
    "    texttemplate='$%{text:.0f}B', showscale=True, colorbar=dict(x=0.45)\n",
    "), row=1, col=1)\n",
    "\n",
    "fig_sens.add_trace(go.Heatmap(\n",
    "    z=df_sens_nav.values, x=df_sens_nav.columns, y=df_sens_nav.index,\n",
    "    colorscale='RdYlGn', text=df_sens_nav.values,\n",
    "    texttemplate='$%{text:.0f}', showscale=True, colorbar=dict(x=1.0)\n",
    "), row=1, col=2)\n",
    "\n",
    "fig_sens.update_layout(\n",
    "    title=\"FCX Sensitivity Analysis: Enterprise Value ($B) & NAV/Share vs WACC × Copper Price\",\n",
