    "# ═══ PRODUCTION SCHEDULE 2025–2040 ════════════════════════════════════════════\n",
    "years_range = list(range(START_YEAR, START_YEAR + FORECAST_YEARS))\n",
    "\n",
    "def get_production_fraction(mine, year):\n",
    "    \"\"\"Calculate production fraction based on ramp-up and mine life.\"\"\"\n",
    "    first_yr = mine['first_production_year']\n",
    "    life_yr = first_yr + mine['mine_life_years']\n",
    "    ramp_yrs = mine['ramp_years']\n",
    "    \n",
    "    if year < first_yr or year >= life_yr:\n",
    "        return 0.0\n",
    "    \n",
    "    years_since_start = year - first_yr\n",
    "    if ramp_yrs > 0 and years_since_start < ramp_yrs:\n",
    "        return years_since_start / ramp_yrs\n",
    "    return 1.0\n",
    "\n",
    "# Special handling for Grasberg — mud rush impact\n",
    "# 2025: ~50% utilisation (partial year suspension + ramp-down)\n",
    "# 2026: ~55% (phased restart, similar to 2025 per guidance)\n",
    "# 2027-2029: ramp back to full rates (60%, 80%, 100%)\n",
    "grasberg_adj = {2025: 0.50, 2026: 0.55, 2027: 0.65, 2028: 0.85, 2029: 1.00}\n",
    "\n",
    "prod_schedule = {}\n",
    "for mine_name, mine in all_mines.items():\n",
    "    prod_schedule[mine_name] = []\n",
    "    for yr in years_range:\n",
    "        frac = get_production_fraction(mine, yr)\n",
    "        \n",
    "        # Apply Grasberg incident adjustment\n",
    "        if 'Grasberg (PTFI' in mine_name and yr in grasberg_adj:\n",
    "            frac = grasberg_adj[yr]\n",
    "        \n",
    "        prod_kt = mine['nameplate_capacity_ktpa_cu'] * frac\n",
    "        prod_schedule[mine_name].append(prod_kt)\n",
    "\n",
    "df_prod = pd.DataFrame(prod_schedule, index=years_range)\n",
    "df_prod['Total_Cu_kt'] = df_prod.sum(axis=1)\n",
    "df_prod['Total_Cu_Blbs'] = df_prod['Total_Cu_kt'] * LBS_PER_TONNE / 1e9\n",
    "\n",
    "# Stacked production chart\n",
    "fig_prod2 = go.Figure()\n",
    "mine_colors = ['#B87333','#CD853F','#DEB887','#D2691E','#8B4513','#A0522D','#6B3A2A','#4B2A1A','#FF8C00','#FFA500']\n",
    "mine_names = list(all_mines.keys())\n",
    "\n",
    "for i, m_name in enumerate(mine_names):\n",
    "    if df_prod[m_name].sum() > 0:\n",
    "        fig_prod2.add_trace(go.Scatter(\n",
    "            x=years_range, y=df_prod[m_name],\n",
    "            name=m_name[:30], stackgroup='one',\n",
    "            fillcolor=mine_colors[i % len(mine_colors)],\n",
    "            line=dict(color=mine_colors[i % len(mine_colors)], width=0.5)\n",
    "        ))\n",
    "\n",
    "fig_prod2.update_layout(\n",
    "    title=\"FCX Attributable Copper Production Schedule (ktpa) — All Mines\",\n",
    "    xaxis_title=\"Year\", yaxis_title=\"ktpa Cu (FCX Attributable)\",\n",
    "    hovermode=\"x unified\", template=\"plotly_white\", height=500,\n",
    "    legend=dict(orientation=\"h\", y=-0.4, font_size=10)\n",
    ")\n",
    "fig_prod2.show()\n",
    "\n",
    "# Production profile\n",
    "print(f\"\\n📊 FCX Attributable Copper Production Forecast (Blbs/yr):\")\n",
    "for yr in [2025, 2026, 2027, 2028, 2029, 2030, 2035, 2040]:\n",
    "    if yr in df_prod.index:\n",
    "        print(f\"   {yr}: {df_prod.loc[yr,'Total_Cu_Blbs']:.2f} Blbs  ({df_prod.loc[yr,'Total_Cu_kt']:.0f} kt)\")\n"
   ]
