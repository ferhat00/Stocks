    "# ═══ SCENARIO COMPARISON TABLE ════════════════════════════════════════════════\n",
    "scenarios_detail = {}\n",
    "for sc, cu_price in [('Bear', COPPER_PRICE_BEAR_LB), ('Base', COPPER_PRICE_BASE_LB), ('Bull', COPPER_PRICE_BULL_LB)]:\n",
    "    r = dcf_valuation(cu_price, label=sc)\n",
    "    \n",
    "    # Build mine P&L for 2028 (post-Grasberg recovery)\n",
    "    mine_rows = []\n",
    "    for mine_name, mine in all_mines.items():\n",
    "        df_m = model_mine(mine_name, mine, cu_price, [2028])\n",
    "        df_m = df_m.set_index('year')\n",
    "        mine_rows.append({\n",
    "            'Mine': mine_name[:35],\n",
    "            'Cu Prod (kt)': round(df_m.loc[2028, 'cu_production_kt'], 0),\n",
    "            'Revenue ($M)': round(df_m.loc[2028, 'total_revenue_usdm'], 0),\n",
    "            'EBITDA ($M)': round(df_m.loc[2028, 'ebitda_usdm'] - GA_BASE_USD_M/len(all_mines), 0),\n",
    "            'FCF ($M)': round(df_m.loc[2028, 'fcf_usdm'], 0),\n",
    "        })\n",
    "    \n",
    "    scenarios_detail[sc] = {\n",
    "        'result': r,\n",
    "        'mine_table': pd.DataFrame(mine_rows)\n",
    "    }\n",
    "\n",
    "# Summary plot\n",
    "scenario_labels = ['Bear', 'Base', 'Bull']\n",
    "nav_values = [scenarios_detail[s]['result']['nav_per_share'] for s in scenario_labels]\n",
    "ev_values  = [scenarios_detail[s]['result']['enterprise_value_usdm'] / 1000 for s in scenario_labels]\n",
    "cu_labels  = [f\"${scenarios_detail[s]['result']['copper_price_lb']:.2f}/lb\" for s in scenario_labels]\n",
    "\n",
    "fig_sc = make_subplots(rows=1, cols=2, subplot_titles=[\"NAV per Share ($)\", \"Enterprise Value ($B)\"])\n",
    "colors_sc = ['#F44336', '#B87333', '#4CAF50']\n",
    "\n",
    "fig_sc.add_trace(go.Bar(x=[f\"{s}\\n{l}\" for s,l in zip(scenario_labels, cu_labels)],\n",
    "                         y=nav_values, marker_color=colors_sc,\n",
    "                         text=[f\"${v:.2f}\" for v in nav_values],\n",
    "                         textposition='outside'), row=1, col=1)\n",
    "fig_sc.add_trace(go.Bar(x=[f\"{s}\\n{l}\" for s,l in zip(scenario_labels, cu_labels)],\n",
    "                         y=ev_values, marker_color=colors_sc,\n",
    "                         text=[f\"${v:.0f}B\" for v in ev_values],\n",
    "                         textposition='outside'), row=1, col=2)\n",
    "\n",
    "# Current price reference line\n",
    "fig_sc.add_hline(y=CURRENT_PRICE, line_dash='dash', line_color='navy',\n",
    "                  annotation_text=f'Current ${CURRENT_PRICE}', row=1, col=1)\n",
    "\n",
    "fig_sc.update_layout(\n",
    "    title=f\"FCX Bear / Base / Bull Scenario Comparison (Current Price: ${CURRENT_PRICE})\",\n",
    "    template='plotly_white', height=420, showlegend=False\n",
    ")\n",
    "fig_sc.show()\n",
    "\n",
    "print(f\"{'═'*60}\")\n",
    "print(f\"  {'SCENARIO SUMMARY':^56}\")\n",
    "print(f\"{'═'*60}\")\n",
    "print(f\"  {'':20} {'BEAR':>12} {'BASE':>12} {'BULL':>12}\")\n",
    "print(f\"  {'─'*56}\")\n",
    "for metric in ['Copper Price ($/lb)', 'NAV/Share ($)', 'Upside/(Downside)', 'EV ($B)', 'P/NAV (x)']:\n",
    "    if metric == 'Copper Price ($/lb)':\n",
    "        vals = [f\"${scenarios_detail[s]['result']['copper_price_lb']:.2f}\" for s in ['Bear','Base','Bull']]\n",
    "    elif metric == 'NAV/Share ($)':\n",
    "        vals = [f\"${scenarios_detail[s]['result']['nav_per_share']:.2f}\" for s in ['Bear','Base','Bull']]\n",
    "    elif metric == 'Upside/(Downside)':\n",
    "        vals = [f\"{(scenarios_detail[s]['result']['nav_per_share']-CURRENT_PRICE)/CURRENT_PRICE*100:+.0f}%\" \n",
    "                for s in ['Bear','Base','Bull']]\n",
    "    elif metric == 'EV ($B)':\n",
    "        vals = [f\"${scenarios_detail[s]['result']['enterprise_value_usdm']/1000:.0f}B\" for s in ['Bear','Base','Bull']]\n",
    "    elif metric == 'P/NAV (x)':\n",
    "        vals = [f\"{scenarios_detail[s]['result']['p_nav']:.2f}x\" for s in ['Bear','Base','Bull']]\n",
    "    print(f\"  {metric:<20} {'  '.join(f'{v:>12}' for v in vals)}\")\n"
