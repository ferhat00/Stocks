    "# ═══ MINE-LEVEL P&L MODEL ════════════════════════════════════════════════════\n",
    "def model_mine(mine_name, mine, copper_price_lb, years_list):\n",
    "    rows = []\n",
    "    for year in years_list:\n",
    "        frac = get_production_fraction(mine, year)\n",
    "        if 'Grasberg (PTFI' in mine_name and year in grasberg_adj:\n",
    "            frac = grasberg_adj[year]\n",
    "        \n",
    "        cu_prod_kt = mine['nameplate_capacity_ktpa_cu'] * frac\n",
    "        cu_prod_lbs_m = cu_prod_kt * 1000 * LBS_PER_TONNE / 1e6  # million lbs\n",
    "        \n",
    "        # Revenues\n",
    "        cu_revenue = cu_prod_lbs_m * copper_price_lb          # $M\n",
    "        au_revenue = mine.get('gold_koz_yr', 0) * frac * GOLD_PRICE_OZ / 1e3\n",
    "        ag_revenue = mine.get('silver_koz_yr', 0) * frac * SILVER_PRICE_OZ / 1e3\n",
    "        mo_revenue = mine.get('moly_mlbs_yr', 0) * frac * MOLY_PRICE_LB\n",
    "        by_product_rev = au_revenue + ag_revenue + mo_revenue\n",
    "        total_revenue = cu_revenue + by_product_rev\n",
    "        \n",
    "        # Costs\n",
    "        # AISC applied to copper production only; by-products already credited via revenue\n",
    "        aisc_total = cu_prod_lbs_m * mine['aisc_lb'] if frac > 0 else 0\n",
    "        royalties = total_revenue * mine['royalty_pct'] / 100\n",
    "        sustaining_cap = mine['capex_sustaining_annual_usdm'] * frac\n",
    "        \n",
    "        # Development capex (major projects front-loaded over 5 years from start)\n",
    "        dev_capex = 0\n",
    "        yrs_to_nameplate = mine.get('ramp_years', 0)\n",
    "        first_yr = mine['first_production_year']\n",
    "        if mine['capex_remaining_usdm'] > 0 and year >= first_yr - 3 and year < first_yr + max(yrs_to_nameplate, 3):\n",
    "            dev_capex = mine['capex_remaining_usdm'] / (max(yrs_to_nameplate, 3) + 3)\n",
    "        \n",
    "        ebitda = total_revenue - aisc_total - royalties\n",
    "        \n",
    "        # Depreciation (straight line over mine life)\n",
    "        initial_capex = mine['capex_remaining_usdm']\n",
    "        depletion = initial_capex / mine['mine_life_years'] if mine['mine_life_years'] > 0 else 0\n",
    "        \n",
    "        ebit = ebitda - depletion\n",
    "        tax = max(0, ebit * mine['tax_rate'])\n",
    "        fcf = ebit - tax + depletion - sustaining_cap - dev_capex\n",
    "        \n",
    "        rows.append({\n",
    "            'year': year, 'mine': mine_name,\n",
    "            'cu_production_kt': cu_prod_kt,\n",
    "            'cu_revenue_usdm': round(cu_revenue, 1),\n",
    "            'by_product_revenue_usdm': round(by_product_rev, 1),\n",
    "            'total_revenue_usdm': round(total_revenue, 1),\n",
    "            'aisc_total_usdm': round(aisc_total, 1),\n",
    "            'royalties_usdm': round(royalties, 1),\n",
    "            'ebitda_usdm': round(ebitda, 1),\n",
    "            'depletion_usdm': round(depletion, 1),\n",
    "            'ebit_usdm': round(ebit, 1),\n",
    "            'tax_usdm': round(tax, 1),\n",
    "            'sustaining_capex_usdm': round(sustaining_cap, 1),\n",
    "            'dev_capex_usdm': round(dev_capex, 1),\n",
    "            'fcf_usdm': round(fcf, 1),\n",
    "        })\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "# Build base case model for all mines\n",
    "all_mine_dfs = {}\n",
    "for mine_name, mine in all_mines.items():\n",
    "    all_mine_dfs[mine_name] = model_mine(mine_name, mine, COPPER_PRICE_BASE_LB, years_range)\n",
    "\n",
    "# Consolidated P&L\n",
    "consolidated_rows = []\n",
    "for yr in years_range:\n",
    "    cu_rev = sum(df.loc[df['year']==yr, 'cu_revenue_usdm'].values[0] for df in all_mine_dfs.values())\n",
    "    bp_rev = sum(df.loc[df['year']==yr, 'by_product_revenue_usdm'].values[0] for df in all_mine_dfs.values())\n",
    "    total_rev = cu_rev + bp_rev\n",
    "    aisc = sum(df.loc[df['year']==yr, 'aisc_total_usdm'].values[0] for df in all_mine_dfs.values())\n",
    "    royalties = sum(df.loc[df['year']==yr, 'royalties_usdm'].values[0] for df in all_mine_dfs.values())\n",
    "    depletion = sum(df.loc[df['year']==yr, 'depletion_usdm'].values[0] for df in all_mine_dfs.values())\n",
    "    tax = sum(df.loc[df['year']==yr, 'tax_usdm'].values[0] for df in all_mine_dfs.values())\n",
    "    sust_capex = sum(df.loc[df['year']==yr, 'sustaining_capex_usdm'].values[0] for df in all_mine_dfs.values())\n",
    "    dev_capex = sum(df.loc[df['year']==yr, 'dev_capex_usdm'].values[0] for df in all_mine_dfs.values())\n",
    "    \n",
    "    ebitda = total_rev - aisc - royalties - GA_BASE_USD_M\n",
    "    ebit = ebitda - depletion\n",
    "    fcf = ebit - tax + depletion - sust_capex - dev_capex\n",
    "    \n",
    "    consolidated_rows.append({\n",
    "        'year': yr,\n",
    "        'cu_revenue_usdm': round(cu_rev, 0),\n",
    "        'by_product_revenue_usdm': round(bp_rev, 0),\n",
    "        'total_revenue_usdm': round(total_rev, 0),\n",
    "        'aisc_total_usdm': round(aisc, 0),\n",
    "        'royalties_usdm': round(royalties, 0),\n",
    "        'ga_usdm': GA_BASE_USD_M,\n",
    "        'ebitda_usdm': round(ebitda, 0),\n",
    "        'depletion_usdm': round(depletion, 0),\n",
    "        'ebit_usdm': round(ebit, 0),\n",
    "        'tax_usdm': round(tax, 0),\n",
    "        'sustaining_capex_usdm': round(sust_capex, 0),\n",
    "        'dev_capex_usdm': round(dev_capex, 0),\n",
    "        'fcf_usdm': round(fcf, 0),\n",
    "    })\n",
    "\n",
    "df_consol = pd.DataFrame(consolidated_rows).set_index('year')\n",
    "\n",
    "# Print key P&L table\n",
    "print(f\"\\n{'═'*80}\")\n",
    "print(f\"  FCX CONSOLIDATED P&L — BASE CASE (Cu ${COPPER_PRICE_BASE_LB}/lb) — USD Millions\")\n",
    "print(f\"{'═'*80}\")\n",
    "print(f\"{'Metric':<35} {'2025':>8} {'2026':>8} {'2027':>8} {'2028':>8} {'2030':>8}\")\n",
    "print(f\"{'─'*80}\")\n",
    "for metric, col in [\n",
    "    (\"Copper Revenue\", 'cu_revenue_usdm'),\n",
    "    (\"By-product Revenue\", 'by_product_revenue_usdm'),\n",
    "    (\"Total Revenue\", 'total_revenue_usdm'),\n",
    "    (\"AISC Costs\", 'aisc_total_usdm'),\n",
    "    (\"Royalties\", 'royalties_usdm'),\n",
    "    (\"G&A\", 'ga_usdm'),\n",
    "    (\"EBITDA\", 'ebitda_usdm'),\n",
    "    (\"Depreciation/Depletion\", 'depletion_usdm'),\n",
    "    (\"EBIT\", 'ebit_usdm'),\n",
    "    (\"Tax\", 'tax_usdm'),\n",
    "    (\"FCF\", 'fcf_usdm'),\n",
    "]:\n",
    "    vals = [f\"${df_consol.loc[yr, col]:,.0f}\" for yr in [2025, 2026, 2027, 2028, 2030]]\n",
    "    print(f\"  {metric:<33} {'  '.join(f'{v:>8}' for v in vals)}\")\n",
    "\n",
    "ebitda_margin_2027 = df_consol.loc[2027, 'ebitda_usdm'] / df_consol.loc[2027, 'total_revenue_usdm'] * 100\n",
    "print(f\"\\n  EBITDA Margin 2027E: {ebitda_margin_2027:.0f}%\")\n"
   ]
