    "# ═══ REVENUE MODEL (3 SCENARIOS) ════════════════════════════════════════════\n",
    "def calc_revenue_by_year(copper_price_lb):\n",
    "    revenues = []\n",
    "    for yr in years_range:\n",
    "        cu_rev = df_prod.loc[yr, 'Total_Cu_kt'] * 1000 * LBS_PER_TONNE * copper_price_lb / 1e6\n",
    "        \n",
    "        # By-product revenues\n",
    "        bp_rev = 0\n",
    "        for mine_name, mine in all_mines.items():\n",
    "            frac = get_production_fraction(mine, yr)\n",
    "            if 'Grasberg (PTFI' in mine_name and yr in grasberg_adj:\n",
    "                frac = grasberg_adj[yr]\n",
    "            au_rev  = mine.get('gold_koz_yr', 0) * frac * GOLD_PRICE_OZ / 1e3\n",
    "            ag_rev  = mine.get('silver_koz_yr', 0) * frac * SILVER_PRICE_OZ / 1e3\n",
    "            mo_rev  = mine.get('moly_mlbs_yr', 0) * frac * MOLY_PRICE_LB\n",
    "            bp_rev += au_rev + ag_rev + mo_rev\n",
    "        \n",
    "        revenues.append({'year': yr, 'cu_revenue': cu_rev, 'by_product_revenue': bp_rev,\n",
    "                         'total_revenue': cu_rev + bp_rev})\n",
    "    return pd.DataFrame(revenues).set_index('year')\n",
    "\n",
    "df_rev_bear = calc_revenue_by_year(COPPER_PRICE_BEAR_LB)\n",
    "df_rev_base = calc_revenue_by_year(COPPER_PRICE_BASE_LB)\n",
    "df_rev_bull = calc_revenue_by_year(COPPER_PRICE_BULL_LB)\n",
    "\n",
    "fig_rev = go.Figure()\n",
    "fig_rev.add_trace(go.Scatter(x=years_range, y=df_rev_bull['total_revenue'],\n",
    "    name=f'Bull (Cu ${COPPER_PRICE_BULL_LB}/lb)', line=dict(color='green', width=2),\n",
    "    fill='tonexty', fillcolor='rgba(0,128,0,0.1)'))\n",
    "fig_rev.add_trace(go.Scatter(x=years_range, y=df_rev_base['total_revenue'],\n",
    "    name=f'Base (Cu ${COPPER_PRICE_BASE_LB}/lb)', line=dict(color='#B87333', width=3)))\n",
    "fig_rev.add_trace(go.Scatter(x=years_range, y=df_rev_bear['total_revenue'],\n",
    "    name=f'Bear (Cu ${COPPER_PRICE_BEAR_LB}/lb)', line=dict(color='red', width=2),\n",
    "    fill='tonexty', fillcolor='rgba(255,0,0,0.1)'))\n",
    "fig_rev.add_trace(go.Scatter(x=years_range, y=df_rev_base['by_product_revenue'],\n",
    "    name='By-product Revenue (Base)', line=dict(color='gold', width=2, dash='dot')))\n",
    "\n",
    "fig_rev.update_layout(\n",
    "    title=\"FCX Consolidated Revenue Forecast — Bear/Base/Bull (USD Millions)\",\n",
    "    xaxis_title=\"Year\", yaxis_title=\"Revenue ($M)\",\n",
    "    hovermode=\"x unified\", template=\"plotly_white\", height=450,\n",
    "    legend=dict(orientation=\"h\", y=-0.3)\n",
    ")\n",
    "fig_rev.show()\n",
    "\n",
    "peak_base = df_rev_base['total_revenue'].max()\n",
    "peak_yr = df_rev_base['total_revenue'].idxmax()\n",
    "bp_pct = df_rev_base['by_product_revenue'].mean() / df_rev_base['total_revenue'].mean()\n",
    "print(f\"\\n💰 Revenue Summary (Base Case):\")\n",
    "print(f\"   2025E: ${df_rev_base.loc[2025,'total_revenue']:,.0f}M\")\n",
    "print(f\"   2027E: ${df_rev_base.loc[2027,'total_revenue']:,.0f}M (Grasberg recovery)\")\n",
    "print(f\"   Peak:  ${peak_base:,.0f}M in {peak_yr}\")\n",
    "print(f\"   By-products avg {bp_pct*100:.0f}% of total revenue — key swing factor\")\n"
