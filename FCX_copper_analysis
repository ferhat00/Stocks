    "# ═══ WATERFALL CHART — 2027 BASE CASE ════════════════════════════════════════\n",
    "def waterfall_chart(year, df, title_suffix=\"Base Case\"):\n",
    "    row = df.loc[year]\n",
    "    \n",
    "    labels  = ['Cu Revenue', 'By-Products', 'Total Revenue', 'AISC Costs',\n",
    "               'Royalties', 'G&A', 'EBITDA', 'D&D', 'EBIT', 'Tax', 'FCF']\n",
    "    values  = [row['cu_revenue_usdm'],\n",
    "               row['by_product_revenue_usdm'],\n",
    "               row['total_revenue_usdm'],\n",
    "               -row['aisc_total_usdm'],\n",
    "               -row['royalties_usdm'],\n",
    "               -row['ga_usdm'],\n",
    "               row['ebitda_usdm'],\n",
    "               -row['depletion_usdm'],\n",
    "               row['ebit_usdm'],\n",
    "               -row['tax_usdm'],\n",
    "               row['fcf_usdm']]\n",
    "    measure = ['absolute','relative','total','relative','relative','relative',\n",
    "               'total','relative','total','relative','total']\n",
    "    \n",
    "    fig = go.Figure(go.Waterfall(\n",
    "        name=\"P&L\", orientation=\"v\", measure=measure,\n",
    "        x=labels, y=values,\n",
    "        connector={\"line\": {\"color\": \"rgb(63,63,63)\"}},\n",
    "        increasing={\"marker\": {\"color\": \"#4CAF50\"}},\n",
    "        decreasing={\"marker\": {\"color\": \"#F44336\"}},\n",
    "        totals={\"marker\": {\"color\": \"#B87333\"}}\n",
    "    ))\n",
    "    fig.update_layout(\n",
    "        title=f\"{COMPANY_NAME} P&L Bridge — {year} ({title_suffix})\",\n",
    "        yaxis_title=\"USD Millions\", template=\"plotly_white\", height=480\n",
    "    )\n",
    "    fig.show()\n",
    "\n",
    "waterfall_chart(2027, df_consol, f\"Base Case Cu ${COPPER_PRICE_BASE_LB}/lb\")\n",
    "\n",
    "# EBITDA over time\n",
    "fig_ebitda = go.Figure()\n",
    "fig_ebitda.add_trace(go.Bar(x=years_range, y=df_consol['ebitda_usdm'],\n",
    "                             name='EBITDA (Base)', marker_color='#B87333'))\n",
    "fig_ebitda.add_trace(go.Scatter(x=years_range, y=df_consol['fcf_usdm'],\n",
    "                                 name='FCF (Base)', line=dict(color='green', width=2.5)))\n",
    "\n",
    "# Add management EBITDA guidance reference lines\n",
    "fig_ebitda.add_hline(y=11000, line_dash='dash', line_color='blue',\n",
    "                      annotation_text='Mgmt Guidance: >$11B EBITDA @ $4 Cu (2026-27)')\n",
    "fig_ebitda.add_hline(y=15500, line_dash='dot', line_color='darkblue',\n",
    "                      annotation_text='Mgmt Guidance: >$15.5B EBITDA @ $5 Cu (2027-28)')\n",
    "\n",
    "fig_ebitda.update_layout(\n",
    "    title=\"FCX EBITDA & FCF Forecast — Base Case\",\n",
    "    xaxis_title=\"Year\", yaxis_title=\"USD Millions\",\n",
    "    template=\"plotly_white\", hovermode=\"x unified\", height=420,\n",
    "    legend=dict(orientation=\"h\", y=1.05)\n",
    ")\n",
    "fig_ebitda.show()\n"
