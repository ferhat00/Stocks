    "# ═══ DCF VALUATION ENGINE ════════════════════════════════════════════════════\n",
    "def dcf_valuation(copper_price_lb, wacc_override=None, label=\"Base\"):\n",
    "    w = wacc_override if wacc_override else WACC\n",
    "    \n",
    "    all_mine_fcfs_list = []\n",
    "    for mine_name, mine in all_mines.items():\n",
    "        df_mine = model_mine(mine_name, mine, copper_price_lb, years_range)\n",
    "        df_mine = df_mine.set_index('year')['fcf_usdm']\n",
    "        all_mine_fcfs_list.append(df_mine)\n",
    "    \n",
    "    total_fcf_series = pd.concat(all_mine_fcfs_list, axis=1).sum(axis=1)\n",
    "    total_fcf_series -= GA_BASE_USD_M  # corporate G&A\n",
    "    \n",
    "    # Discount to PV\n",
    "    fcf_values = total_fcf_series.values\n",
    "    discount_factors = np.array([(1 + w) ** -(i+1) for i in range(FORECAST_YEARS)])\n",
    "    pv_fcfs = fcf_values * discount_factors\n",
    "    pv_fcf_total = sum(pv_fcfs)\n",
    "    \n",
    "    # Terminal value (Gordon Growth on final year FCF)\n",
    "    terminal_fcf = max(total_fcf_series.iloc[-1], 0) * (1 + TERMINAL_GROWTH)\n",
    "    terminal_value = terminal_fcf / (w - TERMINAL_GROWTH)\n",
    "    pv_terminal = terminal_value * discount_factors[-1]\n",
    "    \n",
    "    enterprise_value = pv_fcf_total + pv_terminal\n",
    "    equity_value = enterprise_value - NET_DEBT_USD_M\n",
    "    nav_per_share = equity_value / SHARES_OUT_M if SHARES_OUT_M > 0 else 0\n",
    "    p_nav = CURRENT_PRICE / nav_per_share if nav_per_share > 0 else 0\n",
    "    \n",
    "    return {\n",
    "        'scenario': label,\n",
    "        'copper_price_lb': copper_price_lb,\n",
    "        'enterprise_value_usdm': round(enterprise_value, 0),\n",
    "        'equity_value_usdm': round(equity_value, 0),\n",
    "        'nav_per_share': round(nav_per_share, 2),\n",
    "        'p_nav': round(p_nav, 3),\n",
    "        'pv_fcf_total': round(pv_fcf_total, 0),\n",
    "        'pv_terminal': round(pv_terminal, 0),\n",
    "        'fcf_series': total_fcf_series,\n",
    "    }\n",
    "\n",
    "results = {\n",
    "    'Bear': dcf_valuation(COPPER_PRICE_BEAR_LB, label=f\"Bear (${COPPER_PRICE_BEAR_LB}/lb)\"),\n",
    "    'Base': dcf_valuation(COPPER_PRICE_BASE_LB, label=f\"Base (${COPPER_PRICE_BASE_LB}/lb)\"),\n",
    "    'Bull': dcf_valuation(COPPER_PRICE_BULL_LB, label=f\"Bull (${COPPER_PRICE_BULL_LB}/lb)\"),\n",
    "}\n",
    "\n",
