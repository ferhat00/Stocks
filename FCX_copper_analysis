    "# ═══ COPPER PRICE → NAV EXPLORER ════════════════════════════════════════════\n",
    "cu_prices = np.arange(3.00, 7.10, 0.10)\n",
    "navs, evs, fcfs_2027 = [], [], []\n",
    "\n",
    "for p in cu_prices:\n",
    "    r = dcf_valuation(p, label=\"explore\")\n",
    "    navs.append(r['nav_per_share'])\n",
    "    evs.append(r['enterprise_value_usdm'] / 1000)\n",
    "    \n",
    "    # 2027 FCF at this price\n",
    "    total_fcf_yr = 0\n",
    "    for mine_name, mine in all_mines.items():\n",
    "        df_m = model_mine(mine_name, mine, p, [2027])\n",
    "        total_fcf_yr += df_m['fcf_usdm'].values[0]\n",
    "    total_fcf_yr -= GA_BASE_USD_M\n",
    "    fcfs_2027.append(total_fcf_yr / 1000)\n",
    "\n",
    "fig_explorer = make_subplots(rows=1, cols=2,\n",
