    "# ═══ PEER SCATTER PLOT ═══════════════════════════════════════════════════════\n",
    "fig_peer = go.Figure()\n",
    "\n",
    "for _, row in peers.iterrows():\n",
    "    is_fcx = 'FCX' in row['Company']\n",
    "    fig_peer.add_trace(go.Scatter(\n",
    "        x=[row['C1 Cost ($/lb)']],\n",
    "        y=[row['EV/EBITDA (x)']],\n",
    "        mode='markers+text',\n",
    "        name=row['Ticker'],\n",
    "        marker=dict(\n",
    "            size=max(row['Production (ktpa Cu)'] / 40, 15),\n",
    "            color='#B87333' if is_fcx else 'steelblue',\n",
    "            line=dict(width=3 if is_fcx else 1, color='black' if is_fcx else 'gray'),\n",
    "            symbol='star' if is_fcx else 'circle',\n",
    "        ),\n",
    "        text=[row['Ticker']],\n",
    "        textposition='top center',\n",
    "        textfont=dict(size=11, color='black' if is_fcx else 'gray')\n",
    "    ))\n",
    "\n",
    "fig_peer.add_hline(y=peers['EV/EBITDA (x)'].median(), line_dash='dash', line_color='gray',\n",
    "                    annotation_text=f\"Sector Median: {peers['EV/EBITDA (x)'].median():.1f}x\")\n",
    "fig_peer.add_vline(x=peers['C1 Cost ($/lb)'].median(), line_dash='dash', line_color='gray',\n",
    "                    annotation_text=f\"Median C1: ${peers['C1 Cost ($/lb)'].median():.2f}/lb\")\n",
    "\n",
    "fig_peer.update_layout(\n",
    "    title='Copper Miner Peer Comparison: EV/EBITDA vs C1 Cost (Bubble size = production ktpa)',\n",
    "    xaxis_title='C1 Cash Cost ($/lb, net of by-products)',\n",
    "    yaxis_title='EV/EBITDA (x)',\n",
    "    template='plotly_white', height=480, showlegend=True,\n",
    "    legend=dict(orientation=\"h\", y=-0.25)\n",
    ")\n",
    "fig_peer.show()\n",
    "\n",
    "# Cost curve positioning\n",
    "peers_sorted = peers.sort_values('C1 Cost ($/lb)')\n",
    "fig_cc = go.Figure()\n",
    "cumulative_prod = 0\n",
    "for _, row in peers_sorted.iterrows():\n",
    "    is_fcx = 'FCX' in row['Company']\n",
    "    fig_cc.add_trace(go.Bar(\n",
    "        x=[row['Production (ktpa Cu)']],\n",
    "        y=[row['C1 Cost ($/lb)']],\n",
    "        name=row['Ticker'],\n",
    "        orientation='v',\n",
    "        base=cumulative_prod,\n",
    "        marker_color='#B87333' if is_fcx else 'steelblue',\n",
    "        width=[row['Production (ktpa Cu)']],\n",
    "        customdata=[[row['Company']]],\n",
    "        hovertemplate=f\"{row['Company']}<br>C1: ${row['C1 Cost ($/lb)']}/lb<br>Prod: {row['Production (ktpa Cu)']}kt<extra></extra>\"\n",
    "    ))\n",
    "    cumulative_prod += row['Production (ktpa Cu)']\n",
    "\n",
    "fig_cc.add_hline(y=COPPER_PRICE_BASE_LB, line_dash='dash', line_color='green',\n",
    "                  annotation_text=f'Base Cu ${COPPER_PRICE_BASE_LB}/lb')\n",
    "fig_cc.add_hline(y=COPPER_PRICE_BEAR_LB, line_dash='dot', line_color='red',\n",
    "                  annotation_text=f'Bear Cu ${COPPER_PRICE_BEAR_LB}/lb')\n",
    "fig_cc.update_layout(\n",
    "    title='Industry Cost Curve Positioning (Peer Group)',\n",
    "    xaxis_title='Cumulative Production (ktpa)', yaxis_title='C1 Cost ($/lb)',\n",
    "    template='plotly_white', height=400\n",
    ")\n",
    "fig_cc.show()\n"
