    "# ═══ SUPPLY/DEMAND BALANCE ═══════════════════════════════════════════════════\n",
    "# Mine supply constrained by grade decline, long lead times, resource nationalism\n",
    "mine_supply    = [22500,23100,23600,24000,24300,24500,24700,24800,24900,25000,25100,25200,25300,25400,25500,25600,25700]\n",
    "secondary_scrap= [5500, 5700, 5900, 6200, 6500, 6800, 7100, 7400, 7700, 8000, 8300, 8600, 8900, 9200, 9500, 9800,10100]\n",
    "total_supply   = [m+s for m,s in zip(mine_supply, secondary_scrap)]\n",
    "deficit        = [d - s for d,s in zip(total_demand, total_supply)]\n",
    "\n",
    "fig2 = make_subplots(specs=[[{\"secondary_y\": True}]])\n",
    "fig2.add_trace(go.Bar(x=years, y=mine_supply, name=\"Mine Supply\", marker_color='steelblue', opacity=0.8), secondary_y=False)\n",
    "fig2.add_trace(go.Bar(x=years, y=secondary_scrap, name=\"Secondary/Scrap\", marker_color='lightblue', opacity=0.8), secondary_y=False)\n",
    "fig2.add_trace(go.Scatter(x=years, y=total_demand, name=\"Total Demand\", \n",
    "                          line=dict(color='coral', width=3)), secondary_y=False)\n",
    "fig2.add_trace(go.Scatter(x=years, y=deficit, name=\"Deficit/(Surplus) ktpa\",\n",
    "                          line=dict(color='red', width=2, dash='dot'), \n",
    "                          fill='tozeroy', fillcolor='rgba(255,0,0,0.1)'), secondary_y=True)\n",
    "\n",
    "fig2.update_layout(barmode='stack', title=\"Copper Supply vs Demand Balance (ktpa) — Structural Deficit Emerging\",\n",
    "                   template=\"plotly_white\", hovermode=\"x unified\", height=480,\n",
    "                   legend=dict(orientation=\"h\", y=-0.25))\n",
    "fig2.update_yaxes(title_text=\"ktpa Copper\", secondary_y=False)\n",
    "fig2.update_yaxes(title_text=\"Deficit (ktpa)\", secondary_y=True, tickfont_color='red')\n",
    "fig2.show()\n",
    "\n",
    "peak_deficit_yr = years[deficit.index(max(deficit))]\n",
    "print(f\"\\n⚠️  Peak structural deficit: {max(deficit):,.0f} ktpa in {peak_deficit_yr}\")\n",
    "print(f\"   Cumulative deficit 2026-2035: ~{sum([d for d in deficit[2:12] if d>0]):,.0f} ktpa\")\n",
    "print(f\"   = Equivalent of {sum([d for d in deficit[2:12] if d>0])/4200:.1f}x Freeport's 2024 production\")\n"
   ]
  },
