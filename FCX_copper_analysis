    "# ═══ TORNADO CHART ═══════════════════════════════════════════════════════════\n",
    "base_ev = results['Base']['enterprise_value_usdm']\n",
    "base_nav = results['Base']['nav_per_share']\n",
    "\n",
    "tornado_params = []\n",
    "\n",
    "# Copper price ±20%\n",
    "for label, delta_pct in [('-20% Cu Price', -0.20), ('+20% Cu Price', +0.20)]:\n",
    "    cu_p = COPPER_PRICE_BASE_LB * (1 + delta_pct)\n",
    "    res = dcf_valuation(cu_p, label=\"sens\")\n",
    "    tornado_params.append({'variable': 'Copper Price', 'direction': label,\n",
    "                           'ev_delta': res['enterprise_value_usdm'] - base_ev,\n",
    "                           'nav_delta': res['nav_per_share'] - base_nav})\n",
    "\n",
    "# Gold price ±20%\n",
    "for label, factor in [('-20% Gold', 0.80), ('+20% Gold', 1.20)]:\n",
    "    old_gold = GOLD_PRICE_OZ\n",
    "    GOLD_PRICE_OZ = old_gold * factor\n",
    "    res = dcf_valuation(COPPER_PRICE_BASE_LB, label=\"sens\")\n",
    "    tornado_params.append({'variable': 'Gold Price', 'direction': label,\n",
    "                           'ev_delta': res['enterprise_value_usdm'] - base_ev,\n",
    "                           'nav_delta': res['nav_per_share'] - base_nav})\n",
    "    GOLD_PRICE_OZ = old_gold\n",
    "\n",
    "# WACC ±2pp\n",
    "for label, w in [('WACC +2pp (11%)', 0.11), ('WACC -2pp (7%)', 0.07)]:\n",
    "    res = dcf_valuation(COPPER_PRICE_BASE_LB, wacc_override=w, label=\"sens\")\n",
    "    tornado_params.append({'variable': 'WACC', 'direction': label,\n",
    "                           'ev_delta': res['enterprise_value_usdm'] - base_ev,\n",
    "                           'nav_delta': res['nav_per_share'] - base_nav})\n",
    "\n",
    "# Production ±15% (via AISC proxy — change G&A to simulate volume impact)\n",
    "for label, factor in [('-15% Production', 0.85), ('+15% Production', 1.15)]:\n",
    "    old_ga = GA_BASE_USD_M\n",
    "    # Crude proxy: scale total FCF\n",
    "    GA_BASE_USD_M = old_ga * (2 - factor)  # inverse effect on costs\n",
    "    res = dcf_valuation(COPPER_PRICE_BASE_LB, label=\"sens\")\n",
    "    tornado_params.append({'variable': 'Production Volume', 'direction': label,\n",
    "                           'ev_delta': res['enterprise_value_usdm'] - base_ev,\n",
    "                           'nav_delta': res['nav_per_share'] - base_nav})\n",
    "    GA_BASE_USD_M = old_ga\n",
    "\n",
    "# Group into +/- pairs\n",
    "var_order = ['Copper Price', 'Gold Price', 'WACC', 'Production Volume']\n",
    "low_deltas  = [next(t['ev_delta'] for t in tornado_params if t['variable']==v and t['ev_delta']<0) for v in var_order]\n",
    "high_deltas = [next(t['ev_delta'] for t in tornado_params if t['variable']==v and t['ev_delta']>0) for v in var_order]\n",
    "\n",
    "fig_tornado = go.Figure()\n",
    "fig_tornado.add_trace(go.Bar(y=var_order, x=low_deltas, orientation='h',\n",
    "                              name='Downside Scenario', marker_color='#F44336'))\n",
    "fig_tornado.add_trace(go.Bar(y=var_order, x=high_deltas, orientation='h',\n",
    "                              name='Upside Scenario', marker_color='#4CAF50'))\n",
    "fig_tornado.add_vline(x=0, line_color='black', line_width=1.5)\n",
    "fig_tornado.update_layout(\n",
    "    title='Tornado Chart — FCX Enterprise Value Sensitivity to ±20% Change in Key Assumptions',\n",
    "    xaxis_title='Change in Enterprise Value ($M)', template='plotly_white',\n",
    "    barmode='overlay', height=400,\n",
    "    legend=dict(orientation=\"h\", y=1.05)\n",
    ")\n",
    "fig_tornado.show()\n",
    "\n",
    "print(\"\\n🌪️  Key sensitivities to EV:\")\n",
    "for var, lo, hi in zip(var_order, low_deltas, high_deltas):\n",
    "    print(f\"   {var:<25}: Range ${lo:>+8,.0f}M  to  ${hi:>+8,.0f}M\")\n",
    "print(f\"\\n   Copper price sensitivity dominates — FCX is a leveraged copper play\")\n",
    "print(f\"   Gold price sensitivity is ~{abs(high_deltas[1])/abs(high_deltas[0])*100:.0f}% as impactful as copper — critical by-product\")\n"
   ]
