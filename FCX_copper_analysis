    "}\n",
    "\n",
    "df_demand = pd.DataFrame(demand_data, index=years)\n",
    "\n",
    "colors = ['#1565C0','#795548','#4CAF50','#FFC107','#9E9E9E','#9C27B0','#FF5722','#607D8B']\n",
